{
  "name": "notice.js",
  "version": "1.0.0",
  "description": "A tiny, dependency-free, accessible and secure-by-default toast notification library written in TypeScript",
  "homepage": "https://noticejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alihesari/notice.js.git"
  },
  "bugs": {
    "url": "https://github.com/alihesari/notice.js/issues"
  },
  "author": {
    "name": "Ali Hesari",
    "url": "https://alihesari.com"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "./dist/notice.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/notice.js",
  "jsdelivr": "./dist/notice.js",
  "style": "./dist/noticejs.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./noticejs.css": "./dist/noticejs.css",
    "./style.css": "./dist/noticejs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && esbuild src/noticejs.css --minify --outfile=dist/noticejs.css --log-level=warning",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:pkg": "publint --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit",
    "site": "npm run build && rm -rf site/dist && cp -r dist site/dist",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:pkg && npm run size",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "notification",
    "notice",
    "toast",
    "alert",
    "snackbar",
    "typescript",
    "accessible",
    "a11y",
    "vanilla-js",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=20"
  },
  "size-limit": [
    {
      "name": "ESM (gzip)",
      "path": "dist/index.mjs",
      "import": "{ NoticeJs }",
      "limit": "4 kB",
      "gzip": true
    },
    {
      "name": "Browser bundle (gzip)",
      "path": "dist/notice.js",
      "limit": "4.5 kB",
      "rolldown": false,
      "gzip": true
    },
    {
      "name": "CSS (gzip)",
      "path": "dist/noticejs.css",
      "limit": "2 kB",
      "rolldown": false,
      "gzip": true
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.24",
    "size-limit": "^14.0.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "type": "commonjs"
}
